{
  "name": "STAREY Multi-Platform AI Content Autopilot",
  "flow": [
    {
      "id": 1,
      "module": "notion:watchDatabaseItems",
      "version": 1,
      "parameters": {
        "status": "Approved_For_AI"
      }
    },
    {
      "id": 2,
      "module": "openai:createCompletion",
      "version": 1,
      "parameters": {
        "model": "gpt-4o",
        "prompt": "Repurpose this topic into LinkedIn authority post, X thread, and IG caption."
      }
    },
    {
      "id": 3,
      "module": "router:multiChannelPublish",
      "version": 1,
      "parameters": {
        "channels": ["LinkedIn", "Twitter_X", "Instagram"]
      }
    }
  ]
}
